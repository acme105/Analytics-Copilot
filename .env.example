# Copy to .env and fill in. Never commit .env.

# Kaggle CLI auth. Either save a token to ~/.kaggle/access_token (preferred)
# or set it here.
KAGGLE_API_TOKEN=

# Where the raw Olist CSVs live. Locally `make data` fills data/raw;
# on Kaggle, point this at the attached dataset under /kaggle/input.
OLIST_DATA_DIR=data/raw

# LLM provider (any OpenAI-compatible endpoint). Default: vLLM serving the 3B model.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
SQL_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
SUMMARY_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct

# Query execution
WAREHOUSE_PATH=warehouse/olist.duckdb
MAX_ROWS=200
QUERY_TIMEOUT_S=10
